            "text": "import { getIngredientsApi } from \"/src/utils/burger-api.ts\";\nimport { createSlice, createAsyncThunk } from \"/node_modules/.vite/deps/@reduxjs_toolkit.js?v=55d59fbf\";\nconst initialState = {\n  items: [],\n  isLoading: false,\n  error: null\n};\nexport const fetchIngredients = createAsyncThunk(\n  \"ingredients/fetchIngredients\",\n  async () => {\n    const data = await getIngredientsApi();\n    return data;\n  }\n);\nconst ingredientsSlice = createSlice({\n  name: \"ingredients\",\n  initialState,\n  reducers: {},\n  selectors: {\n    selectIngredients: (state) => state.items,\n    selectIngredientsLoading: (state) => state.isLoading,\n    selectIngredientsError: (state) => state.error\n  },\n  extraReducers: (builder) => {\n    builder.addCase(fetchIngredients.pending, (state) => {\n      state.isLoading = true;\n      state.error = null;\n    }).addCase(fetchIngredients.fulfilled, (state, action) => {\n      state.isLoading = false;\n      state.items = action.payload;\n    }).addCase(fetchIngredients.rejected, (state, action) => {\n      state.isLoading = false;\n      state.error = action.error.message ?? \"Ошибка загрузки ингредиентов\";\n    });\n  }\n});\nexport const { selectIngredients, selectIngredientsLoading, selectIngredientsError } = ingredientsSlice.selectors;\nexport default ingredientsSlice.reducer;\n\n//# sourceMappingURL=data:application/json;base64,"
